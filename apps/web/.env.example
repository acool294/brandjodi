# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this web app (used for auth redirects and links in the mobile app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: Project Settings -> API. Use the publishable (anon) key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server only. The secret (service_role) key bypasses RLS: keep it out of the browser and the mobile app.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Payments: "mock" works with no keys (a fake checkout). "razorpay" uses Razorpay test mode.
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> secret you set for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Shows an email + password form next to email code and Google login. For seeded demo accounts only.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=true
